# Salin jadi telegram/.env lalu isi. File .env TIDAK di-commit (ada di .gitignore).
TELEGRAM_BOT_TOKEN=isi-token-dari-BotFather
# Chat ID Telegram Anda (kirim /id ke bot untuk melihatnya). Pisahkan koma kalau lebih dari satu.
TELEGRAM_ALLOWED_CHAT_IDS=
# Opsional
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=900

# Aturan otomatis realtime (telegram/auto_rules.py)
META_ACCESS_TOKEN=isi_token_system_user
META_RULES_LIVE=0
META_RULES_INTERVAL=120
META_ADS_INTERVAL=600
